; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bloom"
config/description="Hop, glow and collect. A neon platformer where everything blooms."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
run/max_fps=0
boot_splash/bg_color=Color(0.0431373, 0.0392157, 0.12549, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/branding/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/icon="res://assets/branding/icon.png"
config/windows_native_icon="res://assets/branding/icon.ico"
config/quit_on_go_back=false

[autoload]

Save="*res://src/autoload/save.gd"
Sfx="*res://src/autoload/sfx.gd"
Nav="*res://src/autoload/nav.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

theme/default_font_antialiasing=1
common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=2
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.0431373, 0.0392157, 0.12549, 1)
textures/vram_compression/import_etc2_astc=true

[audio]

general/default_playback_type.web=0
