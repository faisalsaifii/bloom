---
const star = 'M32 4l8.2 17.4 19 2.4-14 13.2 3.6 18.9L32 46.6 15.2 55.9l3.6-18.9-14-13.2 19-2.4z';
---
<section class="sec cta-sec" id="play">
	<div class="ring" aria-hidden="true"><i></i><i></i><i></i></div>
	<div class="wrap narrow rv">
		<div class="fstars" aria-hidden="true">
			{[1, 2, 3].map((i) => <svg viewBox="0 0 64 64" style={`--i:${i}`}><path d={star} /></svg>)}
		</div>
		<h2 class="big">Ready to <em class="glow">bloom?</em></h2>
		<div class="ctas c"><a class="btn lg" href="/play/">Play now <span>→</span></a></div>
		<div class="dls">
			<a class="dl" href="https://github.com/faisalsaifii/bloom/releases/download/v1.0.0/Bloom.exe" download>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5l7.5-1v7H3zm8.5-1.2L21 3v8.5h-9.5zM3 12.5h7.5v7L3 18.5zm8.5 0H21V21l-9.5-1.3z" /></svg>
				Windows <small>.exe</small>
			</a>
			<a class="dl" href="https://github.com/faisalsaifii/bloom/releases/download/v1.0.0/Bloom.apk" download>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9h12v9a1.5 1.5 0 0 1-1.5 1.5H15V22h-2v-2.5h-2V22H9v-2.5H7.5A1.5 1.5 0 0 1 6 18zm1-1a5 5 0 0 1 10 0zM3.5 9.5a1 1 0 0 1 2 0V15a1 1 0 0 1-2 0zm15 0a1 1 0 0 1 2 0V15a1 1 0 0 1-2 0z" /></svg>
				Android <small>.apk</small>
			</a>
		</div>
		<p class="small">Web, Windows, Linux, macOS and Android. Keyboard, gamepad or touch.</p>
	</div>
</section>
